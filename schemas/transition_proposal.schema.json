{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ts-lab.invalid/0.1/transition_proposal.schema.json",
  "title": "Transition Proposal",
  "description": "A non-authoritative proposal with a locally constrained transition/effect matrix. Confidence, identity, prose, and extensions cannot authorize it.",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "transition_type",
    "parent_canonical_state_hash",
    "objects_affected",
    "evidence_considered",
    "challenges_considered",
    "mandatory_gate_results",
    "verifier",
    "proposed_post_state_effects",
    "scope_change_classification",
    "version_transition",
    "branch_lifecycle_change",
    "replay_information",
    "human_approval_required",
    "human_approval",
    "authority_basis",
    "producer",
    "provenance",
    "created_at",
    "deterministic_proposal_hash",
    "extensions"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/transitionProposalId" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "transition_type": { "$ref": "common.schema.json#/$defs/transitionType" },
    "parent_canonical_state_hash": { "$ref": "common.schema.json#/$defs/hash" },
    "parent_transition": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/transitionProposalId" },
        { "type": "null" }
      ]
    },
    "objects_affected": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonicalObjectReference" },
      "uniqueItems": true
    },
    "evidence_considered": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "new_supporting_evidence": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "challenges_considered": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/challengeId" },
      "uniqueItems": true
    },
    "mandatory_gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/gateResult" },
          { "type": "object", "properties": { "mandatory": { "const": true } } }
        ]
      }
    },
    "verifier": { "$ref": "common.schema.json#/$defs/verifierIdentity" },
    "proposed_post_state_effects": { "$ref": "common.schema.json#/$defs/transitionEffectSet" },
    "scope_change_classification": { "$ref": "common.schema.json#/$defs/scopeChangeClassification" },
    "version_transition": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/versionTransition" },
        { "type": "null" }
      ]
    },
    "branch_lifecycle_change": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/branchLifecycleChange" },
        { "type": "null" }
      ]
    },
    "broader_scope_justification": { "$ref": "common.schema.json#/$defs/nonBlankString" },
    "replay_information": { "$ref": "common.schema.json#/$defs/completeReplayInstructions" },
    "human_approval_required": { "const": true },
    "human_approval": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/humanApproval" },
        { "type": "null" }
      ]
    },
    "authority_basis": { "const": "VERIFIER_AND_HUMAN_APPROVAL" },
    "producer": { "$ref": "common.schema.json#/$defs/identity" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "deterministic_proposal_hash": { "$ref": "common.schema.json#/$defs/canonicalHash" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "claimCreateEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CREATE" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "claimCommitEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "COMMIT" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "claimRetainEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "RETAIN" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "evidenceAddOrRetainEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "enum": ["CREATE", "RETAIN"] }, "object": { "properties": { "object_type": { "const": "Evidence" } }, "required": ["object_type"] } } }
      ]
    },
    "evidenceRetainEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "RETAIN" }, "object": { "properties": { "object_type": { "const": "Evidence" } }, "required": ["object_type"] } } }
      ]
    },
    "challengeRetainEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "RETAIN" }, "object": { "properties": { "object_type": { "const": "Challenge" } }, "required": ["object_type"] } } }
      ]
    },
    "claimQuarantineEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "QUARANTINE" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "claimRejectEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "REJECT" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "claimRetractEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "RETRACT" }, "object": { "properties": { "object_type": { "const": "Claim" } }, "required": ["object_type"] } } }
      ]
    },
    "obligationCreateEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CREATE" }, "object": { "properties": { "object_type": { "const": "Obligation" } }, "required": ["object_type"] } } }
      ]
    },
    "obligationCloseSatisfiedEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CLOSE_SATISFIED" }, "object": { "properties": { "object_type": { "const": "Obligation" } }, "required": ["object_type"] } } }
      ]
    },
    "obligationCloseKilledEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CLOSE_KILLED" }, "object": { "properties": { "object_type": { "const": "Obligation" } }, "required": ["object_type"] } } }
      ]
    },
    "assumptionAdoptEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "ADOPT" }, "object": { "properties": { "object_type": { "const": "Assumption" } }, "required": ["object_type"] } } }
      ]
    },
    "assumptionRetractEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "RETRACT" }, "object": { "properties": { "object_type": { "const": "Assumption" } }, "required": ["object_type"] } } }
      ]
    },
    "branchCreateEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CREATE" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchOpenEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "OPEN" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchActivateEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "ACTIVATE" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchFreezeEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "FREEZE" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchMergeEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "MERGE" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchAbandonEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "ABANDON" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    },
    "branchCloseEffect": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/transitionEffect" },
        { "properties": { "action": { "const": "CLOSE" }, "object": { "properties": { "object_type": { "const": "Branch" } }, "required": ["object_type"] } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "transition_type": { "enum": ["PROPOSE_CLAIM", "COMMIT_CLAIM", "STRENGTHEN_EVIDENCE", "QUARANTINE_INTERPRETATION", "REJECT_CLAIM", "SUPERSEDE_CLAIM", "RETRACT_CLAIM", "COMMIT_NEGATIVE_DIAGNOSTIC"] } }, "required": ["transition_type"] },
      "then": { "properties": { "scope_change_classification": { "const": "SAME_SCOPE" } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "NARROW_CLAIM_SCOPE" } }, "required": ["transition_type"] },
      "then": {
        "properties": {
          "scope_change_classification": { "const": "NARROWER_SCOPE" },
          "version_transition": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/versionTransition" },
              { "properties": { "relationship": { "const": "NARROWER_SCOPE" }, "prior_object": { "properties": { "object_type": { "const": "Claim" } } }, "replacement_object": { "properties": { "object_type": { "const": "Claim" } } } } }
            ]
          },
          "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" }, "maxContains": 1 }
        }
      }
    },
    {
      "if": { "properties": { "transition_type": { "const": "BROADEN_CLAIM_SCOPE" } }, "required": ["transition_type"] },
      "then": {
        "required": ["new_supporting_evidence", "broader_scope_justification"],
        "properties": {
          "scope_change_classification": { "const": "BROADER_SCOPE" },
          "evidence_considered": { "minItems": 1 },
          "new_supporting_evidence": { "minItems": 1 },
          "challenges_considered": { "minItems": 1 },
          "human_approval": { "$ref": "common.schema.json#/$defs/approvingHumanApproval" },
          "version_transition": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/versionTransition" },
              { "properties": { "relationship": { "const": "BROADER_SCOPE" }, "prior_object": { "properties": { "object_type": { "const": "Claim" } } }, "replacement_object": { "properties": { "object_type": { "const": "Claim" } } } } }
            ]
          },
          "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/evidenceAddOrRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" }, "maxContains": 1, "allOf": [{ "contains": { "$ref": "#/$defs/evidenceAddOrRetainEffect" } }] }
        }
      }
    },
    {
      "if": { "properties": { "transition_type": { "enum": ["CREATE_OBLIGATION", "CLOSE_OBLIGATION_SATISFIED", "CLOSE_OBLIGATION_KILLED", "ADOPT_ASSUMPTION", "SUPERSEDE_ASSUMPTION", "RETRACT_ASSUMPTION", "CREATE_BRANCH", "OPEN_BRANCH", "ACTIVATE_BRANCH", "FREEZE_BRANCH", "MERGE_BRANCH", "ABANDON_BRANCH", "CLOSE_BRANCH", "NO_CANONICAL_CHANGE"] } }, "required": ["transition_type"] },
      "then": { "properties": { "scope_change_classification": { "const": "NOT_APPLICABLE" } } }
    },
    {
      "if": { "properties": { "transition_type": { "not": { "enum": ["NARROW_CLAIM_SCOPE", "BROADEN_CLAIM_SCOPE", "STRENGTHEN_EVIDENCE", "SUPERSEDE_CLAIM", "SUPERSEDE_ASSUMPTION"] } } }, "required": ["transition_type"] },
      "then": { "properties": { "version_transition": { "type": "null" } } }
    },
    {
      "if": { "properties": { "transition_type": { "not": { "enum": ["CREATE_BRANCH", "OPEN_BRANCH", "ACTIVATE_BRANCH", "FREEZE_BRANCH", "MERGE_BRANCH", "ABANDON_BRANCH", "CLOSE_BRANCH"] } } }, "required": ["transition_type"] },
      "then": { "properties": { "branch_lifecycle_change": { "type": "null" } } }
    },
    {
      "if": { "properties": { "human_approval": { "type": "object", "properties": { "action": { "const": "APPROVE" } }, "required": ["action"] } }, "required": ["human_approval"] },
      "then": { "properties": { "mandatory_gate_results": { "items": { "$ref": "common.schema.json#/$defs/mandatoryPassingGateResult" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "PROPOSE_CLAIM" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "$ref": "#/$defs/claimCreateEffect" }, "contains": { "$ref": "#/$defs/claimCreateEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "COMMIT_CLAIM" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "STRENGTHEN_EVIDENCE" } }, "required": ["transition_type"] },
      "then": {
        "properties": {
          "version_transition": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/versionTransition" },
              { "properties": { "relationship": { "const": "STRENGTHENED_SUPPORT" }, "prior_object": { "properties": { "object_type": { "const": "Claim" } } }, "replacement_object": { "properties": { "object_type": { "const": "Claim" } } } } }
            ]
          },
          "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/evidenceAddOrRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" }, "maxContains": 1, "allOf": [{ "contains": { "$ref": "#/$defs/evidenceAddOrRetainEffect" } }] }
        }
      }
    },
    {
      "if": { "properties": { "transition_type": { "const": "QUARANTINE_INTERPRETATION" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimQuarantineEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimQuarantineEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "REJECT_CLAIM" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimRejectEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimRejectEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "SUPERSEDE_CLAIM" } }, "required": ["transition_type"] },
      "then": {
        "properties": {
          "version_transition": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/versionTransition" },
              { "properties": { "relationship": { "const": "SUPERSEDES_CLAIM" }, "prior_object": { "properties": { "object_type": { "const": "Claim" } } }, "replacement_object": { "properties": { "object_type": { "const": "Claim" } } } } }
            ]
          },
          "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" }, "maxContains": 1 }
        }
      }
    },
    {
      "if": { "properties": { "transition_type": { "const": "RETRACT_CLAIM" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimRetractEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimRetractEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "COMMIT_NEGATIVE_DIAGNOSTIC" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "items": { "oneOf": [{ "$ref": "#/$defs/claimCommitEffect" }, { "$ref": "#/$defs/claimRejectEffect" }, { "$ref": "#/$defs/claimRetainEffect" }, { "$ref": "#/$defs/obligationCreateEffect" }, { "$ref": "#/$defs/evidenceRetainEffect" }, { "$ref": "#/$defs/challengeRetainEffect" }] }, "contains": { "$ref": "#/$defs/claimCommitEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "CREATE_OBLIGATION" } }, "required": ["transition_type"] },
      "then": { "properties": { "objects_affected": { "items": { "properties": { "object_type": { "const": "Obligation" } } } }, "proposed_post_state_effects": { "items": { "$ref": "#/$defs/obligationCreateEffect" }, "contains": { "$ref": "#/$defs/obligationCreateEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "CLOSE_OBLIGATION_SATISFIED" } }, "required": ["transition_type"] },
      "then": { "properties": { "objects_affected": { "items": { "properties": { "object_type": { "const": "Obligation" } } } }, "proposed_post_state_effects": { "items": { "$ref": "#/$defs/obligationCloseSatisfiedEffect" }, "contains": { "$ref": "#/$defs/obligationCloseSatisfiedEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "CLOSE_OBLIGATION_KILLED" } }, "required": ["transition_type"] },
      "then": { "properties": { "objects_affected": { "items": { "properties": { "object_type": { "const": "Obligation" } } } }, "proposed_post_state_effects": { "items": { "$ref": "#/$defs/obligationCloseKilledEffect" }, "contains": { "$ref": "#/$defs/obligationCloseKilledEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "enum": ["ADOPT_ASSUMPTION", "SUPERSEDE_ASSUMPTION", "RETRACT_ASSUMPTION"] } }, "required": ["transition_type"] },
      "then": { "properties": { "objects_affected": { "items": { "properties": { "object_type": { "const": "Assumption" } } } }, "proposed_post_state_effects": { "items": { "properties": { "object": { "properties": { "object_type": { "const": "Assumption" } } } } } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "ADOPT_ASSUMPTION" } }, "required": ["transition_type"] },
      "then": { "properties": { "human_approval": { "$ref": "common.schema.json#/$defs/approvingHumanApproval" }, "proposed_post_state_effects": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/assumptionAdoptEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "SUPERSEDE_ASSUMPTION" } }, "required": ["transition_type"] },
      "then": {
        "properties": {
          "version_transition": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/versionTransition" },
              { "properties": { "relationship": { "const": "SUPERSEDES_ASSUMPTION" }, "prior_object": { "properties": { "object_type": { "const": "Assumption" } } }, "replacement_object": { "properties": { "object_type": { "const": "Assumption" } } } } }
            ]
          },
          "proposed_post_state_effects": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/assumptionAdoptEffect" } }
        }
      }
    },
    {
      "if": { "properties": { "transition_type": { "const": "RETRACT_ASSUMPTION" } }, "required": ["transition_type"] },
      "then": { "properties": { "proposed_post_state_effects": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/assumptionRetractEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "enum": ["CREATE_BRANCH", "OPEN_BRANCH", "ACTIVATE_BRANCH", "FREEZE_BRANCH", "MERGE_BRANCH", "ABANDON_BRANCH", "CLOSE_BRANCH"] } }, "required": ["transition_type"] },
      "then": { "properties": { "objects_affected": { "items": { "properties": { "object_type": { "const": "Branch" } } } }, "branch_lifecycle_change": { "$ref": "common.schema.json#/$defs/branchLifecycleChange" }, "proposed_post_state_effects": { "items": { "properties": { "object": { "properties": { "object_type": { "const": "Branch" } } } } } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "CREATE_BRANCH" } }, "required": ["transition_type"] },
      "then": { "properties": { "branch_lifecycle_change": { "properties": { "previous_state": { "type": "null" }, "next_state": { "const": "PROPOSED" } } }, "proposed_post_state_effects": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/branchCreateEffect" } } } }
    },
    {
      "if": { "properties": { "transition_type": { "const": "OPEN_BRANCH" } }, "required": ["transition_type"] },
      "then": { "properties": { "branch_lifecycle_change": { "properties": { "previous_state": { "const": "PROPOSED" }, "next_state": { "const": "OPEN" } } }, "proposed_post_state_effects": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/branchOpenEffect" } } } }
    },
    {
