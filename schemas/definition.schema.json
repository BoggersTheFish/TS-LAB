{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ts-lab.invalid/0.1/definition.schema.json",
  "title": "Definition",
  "description": "A scoped, non-authoritative term definition. Semantic replacement and reference existence require future transition verification.",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "term",
    "meaning",
    "scope",
    "depends_on",
    "producer",
    "provenance",
    "created_at",
    "canonical_hash",
    "extensions"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/definitionId" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "term": { "$ref": "common.schema.json#/$defs/nonBlankString" },
    "meaning": { "$ref": "common.schema.json#/$defs/nonBlankString" },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/definitionId" },
      "uniqueItems": true
    },
    "replaces": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/definitionId" },
        { "type": "null" }
      ]
    },
    "producer": { "$ref": "common.schema.json#/$defs/identity" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "canonical_hash": { "$ref": "common.schema.json#/$defs/canonicalHash" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
