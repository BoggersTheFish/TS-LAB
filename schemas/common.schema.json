{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ts-lab.invalid/0.1/common.schema.json",
  "title": "TS-LAB common contract definitions",
  "description": "Shared Phase 0 Draft 2020-12 definitions. Schema checks are local structural checks; canonical hashes, identities, references, history, and replay truth require a future transition verifier.",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonEmptyString": { "$ref": "#/$defs/nonBlankString" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "description": "Canonical RFC 3339 UTC timestamp with an uppercase trailing Z."
    },
    "absoluteUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableHash": {
      "oneOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "canonicalHash": {
      "allOf": [ { "$ref": "#/$defs/hash" } ],
      "description": "Deterministic SHA-256 of canonical serialized content with the object's own canonical hash field omitted. Phase 0 validates only the lexical form."
    },
    "epistemicClass": {
      "type": "string",
      "enum": ["ESTABLISHED", "REPRODUCTION", "SUBSTRATE_DERIVED", "CONDITIONAL_CONSTRUCTION", "NEGATIVE_DIAGNOSTIC", "HYPOTHESIS", "ANSATZ", "FAILED", "KILL_CONDITION"]
    },
    "transactionState": {
      "type": "string",
      "enum": ["CANDIDATE", "UNDER_REVIEW", "COMMITTED", "QUARANTINED", "REJECTED", "SUPERSEDED", "RETRACTED"]
    },
    "branchLifecycle": {
      "type": "string",
      "enum": ["PROPOSED", "OPEN", "ACTIVE", "FROZEN", "MERGED", "ABANDONED", "CLOSED"]
    },
    "engineeringMaturity": {
      "type": "string",
      "enum": ["SPECIFIED", "IMPLEMENTED", "TESTED", "REPRODUCED", "RELEASED"]
    },
    "gateOutcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN", "UNSUPPORTED", "ERROR", "MISSING"]
    },
    "evidenceOrigin": {
      "type": "string",
      "enum": ["RAW", "DERIVED", "REPRODUCED", "EXTERNAL"]
    },
    "scopeChangeClassification": {
      "type": "string",
      "enum": ["SAME_SCOPE", "NARROWER_SCOPE", "BROADER_SCOPE", "NOT_APPLICABLE"]
    },
    "transitionType": {
      "type": "string",
      "enum": ["PROPOSE_CLAIM", "COMMIT_CLAIM", "STRENGTHEN_EVIDENCE", "NARROW_CLAIM_SCOPE", "BROADEN_CLAIM_SCOPE", "QUARANTINE_INTERPRETATION", "REJECT_CLAIM", "SUPERSEDE_CLAIM", "RETRACT_CLAIM", "COMMIT_NEGATIVE_DIAGNOSTIC", "CREATE_OBLIGATION", "CLOSE_OBLIGATION_SATISFIED", "CLOSE_OBLIGATION_KILLED", "ADOPT_ASSUMPTION", "SUPERSEDE_ASSUMPTION", "RETRACT_ASSUMPTION", "CREATE_BRANCH", "OPEN_BRANCH", "ACTIVATE_BRANCH", "FREEZE_BRANCH", "MERGE_BRANCH", "ABANDON_BRANCH", "CLOSE_BRANCH", "NO_CANONICAL_CHANGE"]
    },
    "transitionEffectAction": {
      "type": "string",
      "enum": ["CREATE", "COMMIT", "ADOPT", "ACTIVATE", "OPEN", "FREEZE", "MERGE", "ABANDON", "CLOSE", "QUARANTINE", "REJECT", "SUPERSEDE", "RETRACT", "CLOSE_SATISFIED", "CLOSE_KILLED", "RETAIN", "NO_CHANGE"]
    },
    "decisionVerdict": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "NARROW", "QUARANTINE", "NO_CANONICAL_CHANGE"]
    },
    "executionOutcome": {
      "type": "string",
      "enum": ["NOT_RUN", "COMPLETED", "FAILED", "TIMED_OUT", "CANCELLED", "UNSUPPORTED"]
    },
    "challengeDisposition": {
      "type": "string",
      "enum": ["OPEN", "SUSTAINED", "RESOLVED", "REJECTED", "SUPERSEDED"]
    },
    "identityRole": {
      "type": "string",
      "enum": ["HUMAN_GOVERNOR", "INVESTIGATOR", "PROPOSER", "EXPERIMENT_RUNNER", "REVIEWER", "TRANSITION_VERIFIER", "GENERATOR", "RENDERER", "SYSTEM", "TOOL", "EXTERNAL_SOURCE"]
    },
    "identity": {
      "type": "object",
      "required": ["id", "role", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "role": { "$ref": "#/$defs/identityRole" },
        "version": { "$ref": "#/$defs/nonBlankString" },
        "implementation_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "verifierIdentity": {
      "type": "object",
      "required": ["id", "role", "version", "ruleset_hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^verifier:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "role": { "const": "TRANSITION_VERIFIER" },
        "version": { "$ref": "#/$defs/nonBlankString" },
        "ruleset_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "provenanceSource": {
      "type": "object",
      "required": ["source_uri", "source_type", "relation"],
      "properties": {
        "source_uri": { "$ref": "#/$defs/absoluteUri" },
        "source_type": { "type": "string", "enum": ["USER_INPUT", "DOCUMENT", "EVIDENCE", "DERIVATION", "EXPERIMENT", "RESULT", "EXTERNAL_SOURCE", "SYSTEM_SEED", "TRANSITION", "RECEIPT" ] },
        "relation": { "$ref": "#/$defs/nonBlankString" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "accessed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["method", "sources"],
      "properties": {
        "method": { "$ref": "#/$defs/nonBlankString" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenanceSource" } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/nonBlankString" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["domain", "boundaries"],
      "properties": {
        "domain": { "$ref": "#/$defs/nonBlankString" },
        "boundaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonBlankString" }, "uniqueItems": true },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/nonBlankString" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "reservedExtensionKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "not": { "pattern": "(accept|approv|authori[sz]|authority|authoritative|confidence|verif|validat|proof|prov(?:e|es|ed|en|ing)|truth|decision|transition|commit|canonical|human[_.-]?approval|receipt|epistemic|transaction[_.-]?state|status|establish|reproduction|substrate[_.-]?derived|conditional[_.-]?construction|negative[_.-]?diagnostic|hypothesis|ansatz|kill[_.-]?condition|candidate|under[_.-]?review|quarantin|reject|supersed|retract|specified|implemented|tested|reproduced|released|pass|fail|unknown|unsupported|error|missing)" }
    },
    "extensionNamespaceKey": {
      "allOf": [
        { "$ref": "#/$defs/reservedExtensionKey" },
        { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9_-]*)+$" }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/extensionNamespaceKey" },
      "additionalProperties": { "$ref": "#/$defs/extensionValue" }
    },
    "extensionValue": {
      "oneOf": [
        { "type": "string", "pattern": "^[^A-Z]*$", "not": { "pattern": "(accept|approv|authori[sz]|authority|authoritative|confidence|verif|validat|proof|prov(?:e|es|ed|en|ing)|truth|decision|transition|commit|canonical|human[_. -]?approval|receipt|epistemic|transaction[_. -]?state|status|establish|reproduction|substrate[_. -]?derived|conditional[_. -]?construction|negative[_. -]?diagnostic|hypothesis|ansatz|kill[_. -]?condition|candidate|under[_. -]?review|quarantin|reject|supersed|retract|specified|implemented|tested|reproduced|released|pass|fail|unknown|unsupported|error|missing)" } },
        { "type": ["number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/extensionValue" } },
        { "type": "object", "propertyNames": { "$ref": "#/$defs/reservedExtensionKey" }, "additionalProperties": { "$ref": "#/$defs/extensionValue" } }
      ]
    },
    "definitionId": { "type": "string", "pattern": "^definition:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "assumptionId": { "type": "string", "pattern": "^assumption:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "evidenceId": { "type": "string", "pattern": "^evidence:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "claimId": { "type": "string", "pattern": "^claim:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "obligationId": { "type": "string", "pattern": "^obligation:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "experimentId": { "type": "string", "pattern": "^experiment:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "resultId": { "type": "string", "pattern": "^result:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "challengeId": { "type": "string", "pattern": "^challenge:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "decisionId": { "type": "string", "pattern": "^decision:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "branchId": { "type": "string", "pattern": "^branch:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "transitionProposalId": { "type": "string", "pattern": "^transition:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "researchReceiptId": { "type": "string", "pattern": "^receipt:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "governanceRecordId": { "type": "string", "pattern": "^governance:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "gateId": { "type": "string", "pattern": "^gate:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "canonicalObjectReference": {
      "type": "object",
      "required": ["object_type", "id", "canonical_hash"],
      "properties": {
        "object_type": { "type": "string", "enum": ["Evidence", "Definition", "Assumption", "Claim", "Obligation", "Experiment", "Result", "Challenge", "Decision", "Branch", "TransitionProposal", "ResearchReceipt" ] },
        "id": { "type": "string", "pattern": "^(evidence|definition|assumption|claim|obligation|experiment|result|challenge|decision|branch|transition|receipt):[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "canonical_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "gateDefinition": {
      "type": "object",
      "required": ["id", "criterion", "evaluation_method", "pass_condition", "mandatory"],
      "properties": {
        "id": { "$ref": "#/$defs/gateId" },
        "criterion": { "$ref": "#/$defs/nonBlankString" },
        "evaluation_method": { "$ref": "#/$defs/nonBlankString" },
        "pass_condition": { "$ref": "#/$defs/nonBlankString" },
        "mandatory": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": ["gate_id", "mandatory", "outcome", "verifier", "evidence", "explanation"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/gateId" },
        "mandatory": { "type": "boolean" },
        "outcome": { "$ref": "#/$defs/gateOutcome" },
        "verifier": { "$ref": "#/$defs/verifierIdentity" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" }, "uniqueItems": true },
        "explanation": { "$ref": "#/$defs/nonBlankString" }
      },
      "additionalProperties": false
    },
    "mandatoryPassingGateResult": {
      "allOf": [
        { "$ref": "#/$defs/gateResult" },
        { "type": "object", "properties": { "mandatory": { "const": true }, "outcome": { "const": "PASS" } } }
      ]
    },
    "mandatoryGateSummary": {
      "type": "object",
      "required": ["all_satisfied", "results"],
      "properties": {
        "all_satisfied": { "type": "boolean" },
        "results": { "type": "array", "minItems": 1, "items": { "allOf": [ { "$ref": "#/$defs/gateResult" }, { "type": "object", "properties": { "mandatory": { "const": true } } } ] } }
      },
      "additionalProperties": false
    },
    "satisfiedMandatoryGateSummary": {
      "type": "object",
      "required": ["all_satisfied", "results"],
      "properties": {
        "all_satisfied": { "const": true },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mandatoryPassingGateResult" } }
      },
      "additionalProperties": false
    },
    "humanApproval": {
      "type": "object",
      "required": ["governance_record_id", "approver", "action", "approved_at", "policy_id", "approval_hash"],
      "properties": {
        "governance_record_id": { "$ref": "#/$defs/governanceRecordId" },
        "approver": { "type": "object", "required": ["id", "role", "version"], "properties": { "id": { "type": "string", "pattern": "^human:[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "role": { "const": "HUMAN_GOVERNOR" }, "version": { "$ref": "#/$defs/nonBlankString" } }, "additionalProperties": false },
        "action": { "type": "string", "enum": ["APPROVE", "NARROW", "REJECT"] },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "policy_id": { "type": "string", "enum": ["authority", "claim_policy", "execution_policy", "human_governance"] },
        "approval_hash": { "$ref": "#/$defs/hash" },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonBlankString" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "approvingHumanApproval": {
      "allOf": [ { "$ref": "#/$defs/humanApproval" }, { "type": "object", "properties": { "action": { "const": "APPROVE" } } } ]
    },
    "policyApproval": {
      "type": "object",
      "required": ["policy_id", "rule_id", "approved", "governance_record_id"],
      "properties": { "policy_id": { "const": "claim_policy" }, "rule_id": { "const": "CLAIM-LIMITATIONS-REQUIRED" }, "approved": { "const": true }, "governance_record_id": { "$ref": "#/$defs/governanceRecordId" } },
      "additionalProperties": false
    },
    "resourceBudget": {
      "type": "object",
      "required": ["wall_time_seconds", "cpu_seconds", "memory_bytes", "storage_bytes", "network_requests"],
      "properties": { "wall_time_seconds": { "type": "integer", "minimum": 1 }, "cpu_seconds": { "type": "integer", "minimum": 1 }, "memory_bytes": { "type": "integer", "minimum": 1 }, "storage_bytes": { "type": "integer", "minimum": 0 }, "network_requests": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "requiredOutput": {
      "type": "object",
      "required": ["output_type", "description", "inspection_method"],
      "properties": { "output_type": { "$ref": "#/$defs/nonBlankString" }, "description": { "$ref": "#/$defs/nonBlankString" }, "inspection_method": { "$ref": "#/$defs/nonBlankString" } },
      "additionalProperties": false
    },
    "stopCondition": {
      "type": "object",
      "required": ["condition", "trigger", "resulting_action"],
      "properties": { "condition": { "$ref": "#/$defs/nonBlankString" }, "trigger": { "$ref": "#/$defs/nonBlankString" }, "resulting_action": { "type": "string", "enum": ["STOP_SATISFIED", "STOP_KILLED", "STOP_BUDGET_EXHAUSTED", "STOP_UNSUPPORTED"] }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["operating_system", "architecture", "runtime_versions", "environment_hash"],
      "properties": { "operating_system": { "$ref": "#/$defs/nonBlankString" }, "architecture": { "$ref": "#/$defs/nonBlankString" }, "runtime_versions": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" }, "additionalProperties": { "$ref": "#/$defs/nonBlankString" } }, "container_image": { "$ref": "#/$defs/nonBlankString" }, "environment_hash": { "$ref": "#/$defs/hash" } },
      "additionalProperties": false
    },
    "executionType": {
      "type": "string",
      "enum": ["COMPUTATIONAL", "PHYSICAL", "DOCUMENTARY", "EXTERNAL_SERVICE"]
    },
    "evidenceClassification": {
      "type": "string",
      "enum": ["SCIENTIFIC_EXECUTION", "NEGATIVE_DIAGNOSTIC", "PARTIAL_EXECUTION", "ADMINISTRATIVE_DIAGNOSTIC", "CAPABILITY_DIAGNOSTIC", "EXTERNAL_DOCUMENTARY"]
    },
    "toolBinding": {
      "type": "object",
      "required": ["tool_id", "version", "implementation_hash"],
      "properties": { "tool_id": { "type": "string", "pattern": "^tool:[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "version": { "$ref": "#/$defs/nonBlankString" }, "implementation_hash": { "$ref": "#/$defs/hash" } },
      "additionalProperties": false
    },
    "workerBinding": {
      "type": "object",
      "required": ["worker_id", "role", "version", "implementation_hash", "responsibilities"],
      "properties": {
        "worker_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "role": { "$ref": "#/$defs/identityRole" },
        "version": { "$ref": "#/$defs/nonBlankString" },
        "implementation_hash": { "$ref": "#/$defs/hash" },
        "responsibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["EXECUTION", "EVIDENCE_RECORDING", "RECEIPT_RECORDING", "REPLAY_EXECUTION"] }
      },
      "additionalProperties": false
    },
    "transitionHumanDecisionRecord": {
      "type": "object",
      "required": ["governance_record_id", "approver", "action", "approved_at", "policy_id", "approval_hash", "approved_transition_id", "approved_transition_hash", "approved_decision_id", "approved_decision_hash", "approved_effect_set_hash"],
      "properties": {
        "governance_record_id": { "$ref": "#/$defs/governanceRecordId" },
        "approver": {
          "type": "object",
          "required": ["id", "role", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^human:[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
            "role": { "const": "HUMAN_GOVERNOR" },
            "version": { "$ref": "#/$defs/nonBlankString" }
          },
          "additionalProperties": false
        },
        "action": { "type": "string", "enum": ["APPROVE", "NARROW", "REJECT"] },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "policy_id": { "const": "human_governance" },
        "approval_hash": { "$ref": "#/$defs/hash" },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonBlankString" }, "uniqueItems": true },
        "approved_transition_id": { "$ref": "#/$defs/transitionProposalId" },
        "approved_transition_hash": { "$ref": "#/$defs/hash" },
        "approved_decision_id": { "$ref": "#/$defs/decisionId" },
        "approved_decision_hash": { "$ref": "#/$defs/hash" },
        "approved_effect_set_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "executionRecord": {
      "type": "object",
      "required": ["experiment_or_result", "observed_outcome"],
      "properties": {
        "experiment_or_result": {
          "allOf": [
            { "$ref": "#/$defs/canonicalObjectReference" },
            { "type": "object", "properties": { "object_type": { "enum": ["Experiment", "Result"] } } }
          ]
        },
        "observed_outcome": { "$ref": "#/$defs/executionOutcome" },
        "notes": { "$ref": "#/$defs/nonBlankString" }
      },
      "additionalProperties": false
    }
  }
}
